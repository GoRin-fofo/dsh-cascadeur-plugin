{
  "name": "@dsh-external/dsh-cascadeur-plugin",
  "version": "0.4.0",
  "description": "Move Cascadeur .casc animations into Blender / UE5: reads per-joint Global Matrix through Cascadeur's official MCP script server, rebuilds the pose in Blender on the original FBX and exports FBX (0.000 cm per-vertex error). Ships error-driven keyframe reduction and Mocap spike repair.",
  "private": false,
  "keywords": [
    "dsh",
    "cascadeur",
    "blender",
    "ue5",
    "animation",
    "fbx",
    "mocap",
    "keyframe-reduction"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "./lib/index.js",
  "files": [
    "lib",
    "runtime",
    "cascadeur_autostart",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "AGENTS.md",
    "LICENSE",
    "install.ps1",
    "uninstall.ps1"
  ],
  "scripts": {
    "test": "node tests/test_core.mjs",
    "test:py": "python tests/test_keyreduce.py",
    "test:casc": "python tests/test_casc_core.py",
    "verify": "python verify/verify_rebuild.py"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GoRin-fofo/dsh-cascadeur-plugin.git"
  },
  "homepage": "https://github.com/GoRin-fofo/dsh-cascadeur-plugin#readme",
  "bugs": {
    "url": "https://github.com/GoRin-fofo/dsh-cascadeur-plugin/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.0.1-rc <2",
    "cordis": ">=4.0.0-rc <5"
  },
  "peerDependenciesMeta": {
    "cordis": {
      "optional": true
    }
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  }
}
