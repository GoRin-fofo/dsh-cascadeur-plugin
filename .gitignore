# 依赖 / 缓存
node_modules/
__pycache__/
*.pyc
*.pyo

# 备份文件（install.ps1 会在 profile 目录产生，但这里兜底）
*.bak
*.bak-*
*.v1-*

# 本机配置（含个人路径，不应入库）
dsh-cascadeur.config.json
*.local.json

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# 导出产物
casc_out/
*.blend1

# GM 缓存 / 中间产物（v0.4.0 起缓存进 _dsh_cache/）
_dsh_cache/
*_gm.json
*.despiked.json
*.meta.json

# 测试固件（make_fixture.py 生成）
tests/_fixture_*.casc
